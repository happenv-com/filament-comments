{
    "name": "happenv-com/filament-comments",
    "description": "Comments module for Filament",
    "keywords": [
        "filament",
        "laravel",
        "filamentphp",
        "comments"
    ],
    "homepage": "https://happenv.com",
    "support": {
        "issues": "https://github.com/happenv-com/filament-comments/issues",
        "source": "https://github.com/happenv-com/filament-comments"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Bartlomiej Gajda",
            "email": "b.gajda@happenv.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.3.1|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentComments\\": "src/",
            "Happenv\\FilamentComments\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentComments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happenv\\FilamentComments\\FilamentCommentsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
